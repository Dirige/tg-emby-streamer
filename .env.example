# docker compose 会读取本文件。复制为 .env 后修改；不要上传真实 .env。
COMPOSE_PROJECT_NAME=tgemby
COMPOSE_PROFILES=emby
TGEMBY_IMAGE=dirige/tgemby:latest
PUID=1000
PGID=1000
TZ=Asia/Shanghai

TGEMBY_BIND=0.0.0.0
TGEMBY_PORT=8001
# 安装时填写 Emby 和客户端都能访问的服务器 IP/域名，不要填写 localhost。
TGEMBY_PUBLIC_URL=
EMBY_BIND=0.0.0.0
EMBY_PORT=8096
# MetaTube 默认只向宿主机本地开放；Emby/TGEmby 使用 Docker 内网。
METATUBE_BIND=127.0.0.1
METATUBE_PORT=8082
METATUBE_URL=http://metatube:8080

# HTTP 代理同时用于 MetaTube 和 TGEmby 的 HTTP 刮削请求。
# 无代理留空。已启用内置 proxy profile 时填写 http://proxy:7890。
# 局域网代理例子：http://192.168.1.2:7890
SCRAPER_PROXY=
PROXY_PORT=7890

# 可选：指定经过测试的版本/镜像镜像站，不建议使用不可信第三方镜像。
METATUBE_IMAGE=ghcr.io/metatube-community/metatube-server:latest
EMBY_IMAGE=lscr.io/linuxserver/emby:latest
MIHOMO_IMAGE=metacubex/mihomo:latest
